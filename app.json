{
  "expo": {
    "name": "Давление",
    "slug": "blood-pressure-diary",
    "version": "0.8.5",
    "orientation": "portrait",
    "icon": "./assets/images/clarity-app-icon.png",
    "scheme": "bloodpressure",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.eggplant4287.coral6481",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "app.eggplant4287.coral6481",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EC",
        "foregroundImage": "./assets/images/clarity-splash-mark.png",
        "monochromeImage": "./assets/images/clarity-splash-mark.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/clarity-splash-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/clarity-splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EC"
        }
      ],
      ["expo-localization", { "supportedLocales": ["ru", "en", "fr", "es", "de"] }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd98d214-c226-4c0c-b7d7-63a4b05b833d"
      }
    },
    "owner": "coolchel"
  }
}
